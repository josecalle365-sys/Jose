
{
  "id": "app.bitchord.lossless-bridge",
  "name": "Lossless Bridge",
  "version": "1.0.0",
  "description": "Complemento de audio sin pérdidas con búsqueda, reproducción y validación de flujos FLAC.",
  "resources": [
    "search",
    "stream"
  ],
  "allowDownloads": 1,
  "checkValidLossless": 1,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        {
          "label": "Lossless",
          "value": "lossless"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Low",
          "value": "low"
        }
      ]
    },
    {
      "key": "prefer",
      "type": "select",
      "default": "studio",
      "options": [
        {
          "label": "Studio masters first",
          "value": "studio"
        },
        {
          "label": "Live and bootlegs first",
          "value": "live"
        }
      ]
    }
  ]
}
